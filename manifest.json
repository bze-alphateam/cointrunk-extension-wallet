{
  "manifest_version": 3,
  "name": "CoinTrunk Wallet",
  "version": "0.0.0",
  "description": "A wallet for the BeeZee (BZE) network. Send and receive BZE and tokens, in skins drawn from each token's on-chain branding.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "CoinTrunk Wallet",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["alarms", "idle", "storage"]
}
